# Environment variables for docker-compose.bot.yml.
# Copy to .env.bot and fill in the placeholders before `docker compose up`.

# --- Telegram app credentials (my.telegram.org) ---
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# --- AI provider (at least one) ---
# OpenAI is recommended for full feature coverage.
OPENAI_API_KEY=
# Optional alternatives:
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# OPENROUTER_API_KEY=

# --- AI provider / model (optional) ---
# The container has its OWN ~/.unread, so `unread settings` run on your
# laptop does not reach it. Without these the bot uses `openai`.
# Providers: openai, openrouter, anthropic, google, local.
# Leave the model empty to use each preset's pinned default.
# UNREAD_AI_CHAT_PROVIDER=openrouter
# UNREAD_AI_CHAT_MODEL=openai/gpt-5.6-luna
# UNREAD_AI_FILTER_PROVIDER=openrouter
# UNREAD_AI_FILTER_MODEL=openai/gpt-5.6-luna

# --- Bot (required) ---
# Token from @BotFather.
UNREAD_BOT_TOKEN=

# --- Bot (optional) ---
# Numeric Telegram user IDs allowed to use the bot. One id, or several
# separated by commas: UNREAD_BOT_OWNER_ID=111,222,333
#
# The FIRST id is the primary owner — the account whose Telegram session
# the bot reads chats through. Only the primary owner can analyze
# `t.me/...` links or run /upload_session; extra admins get files, web
# links and YouTube. That split exists because all admins share ONE
# Telegram session, so letting them send t.me links would expose the
# primary owner's private chats.
#
# Required ONLY when you can't mount an authorized user session before
# starting the bot (e.g. you'll do the /upload_session flow after the
# bot is up). If you mount the session at
# /root/.unread/storage/session.sqlite before `up -d`, the bot derives
# the primary owner from it automatically — any ids you list here stay
# on as extra admins.
# Find your ID by messaging https://t.me/userinfobot.
# UNREAD_BOT_OWNER_ID=
# Max concurrent analyses. 2 is plenty for a single user.
# UNREAD_BOT_CONCURRENCY=2
# Force every analyze to a specific preset (e.g. "summary", "detailed").
# UNREAD_BOT_DEFAULT_PRESET=
# Refuse files larger than this many MB up-front.
# UNREAD_BOT_MAX_FILE_MB=100
# Report attachment format: "pdf" (default — phone Telegram clients
# preview PDFs but not .md) or "md" (skip PDF render). Setting "md"
# is also a workaround for hosts missing libpango (weasyprint's
# native dep) — though the bot already auto-falls-back when render
# fails at runtime.
# UNREAD_BOT_REPORT_FORMAT=pdf
