# Settings for the unread Telegram bot (docker-compose.bot.yml).
#
# Save this as `.env` next to docker-compose.yml (or as `.env.bot` in a
# repo checkout), fill in the required values, then `docker compose up -d`.
# Or skip all of it — the installer asks for these and writes the file:
#   curl -fsSL https://raw.githubusercontent.com/maxbolgarin/unread/main/scripts/install-bot-docker.sh | bash
#
# Keep comments on their own lines: anything after `=` is the value.

# ======================================================================
# Required
# ======================================================================

# Bot token. In Telegram: @BotFather → /newbot.
UNREAD_BOT_TOKEN=

# Your numeric Telegram user id (ask @userinfobot). The bot answers only
# the ids listed here and silently ignores everyone else. For several
# people, separate ids with commas: 111,222 — the first one is the owner.
UNREAD_BOT_OWNER_ID=

# Telegram API id + hash. Telegram requires them for every app, bots
# included. Free: https://my.telegram.org → API development tools →
# create an app (any name).
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# An AI key. OpenAI is the default provider and the one that also
# transcribes voice messages and video.
OPENAI_API_KEY=

# ======================================================================
# Another AI provider (instead of, or next to, OpenAI)
# ======================================================================
# Add its key AND name it as the provider. Models default to that
# provider's own; switch them any time from the bot's /settings menu.
# Voice / video transcription still needs an OpenAI key.
#
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# OPENROUTER_API_KEY=
#
# Provider names: openai, anthropic, google, openrouter, local.
# CHAT writes the report, FILTER does the cheap first pass over long
# inputs, VISION reads images.
# UNREAD_AI_CHAT_PROVIDER=anthropic
# UNREAD_AI_FILTER_PROVIDER=anthropic
# UNREAD_AI_VISION_PROVIDER=anthropic
#
# A provider or model set here outranks the bot's /settings menu.
# UNREAD_AI_CHAT_MODEL=
# UNREAD_AI_FILTER_MODEL=

# ======================================================================
# Optional
# ======================================================================

# Pin an image version instead of tracking :latest.
# UNREAD_BOT_IMAGE=ghcr.io/maxbolgarin/unread:1.10.0

# Report attachment: pdf (default, previews on phones) or md.
# UNREAD_BOT_REPORT_FORMAT=pdf

# Analyses that may run at the same time.
# UNREAD_BOT_CONCURRENCY=2

# Force one preset for everything, e.g. digest or tldr.
# UNREAD_BOT_DEFAULT_PRESET=

# Refuse files bigger than this many MB up front.
# UNREAD_BOT_MAX_FILE_MB=100

# How often the model list and prices refresh, in hours; 0 turns it off.
# UNREAD_AI_CATALOG_REFRESH_HOURS=24

# ======================================================================
# Reading your Telegram chats (optional)
# ======================================================================
# Files, voice, web links and YouTube work without this. To also analyze
# t.me/... links and channels, send /upload_session to the bot once, then
# ~/.unread/storage/session.sqlite.session from your laptop (made by
# `unread init`) as a file. That account becomes the owner; the ids above
# stay on as extra admins.
